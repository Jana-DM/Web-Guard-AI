# Application
APP_NAME="Web Guard AI"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Security (CHANGE ALL SECRETS BEFORE PRODUCTION DEPLOYMENT)
SECRET_KEY=change-this-to-a-long-random-hex-secret-in-production
ENCRYPTION_KEY=change-this-to-a-32-byte-url-safe-base64-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL in production/Docker; SQLite supported for local dev/testing)
DATABASE_URL=sqlite:///./webguard.db
# DATABASE_URL=postgresql+psycopg://webguard:webguard_dev_password@postgres:5432/webguard

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Storage paths
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
REPORTS_DIR=./reports_output
MAX_UPLOAD_SIZE_MB=25

# Domain Scanner Safety Controls
SCAN_HTTP_TIMEOUT_SECONDS=8.0
SCAN_MAX_REDIRECTS=3
SCAN_MAX_ENDPOINTS=40
SCAN_RATE_LIMIT_PER_MINUTE=30
ALLOW_LOCALHOST_SCANNING=false

# Threat Intelligence Feeds (optional API keys increase rate limits)
NVD_API_KEY=
GITHUB_TOKEN=
INTELLIGENCE_SYNC_HOUR_UTC=2

# AI Assistant / LLM Integration (optional; platform falls back to deterministic evidence engine when unset)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
